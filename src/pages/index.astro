<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' blob:; connect-src 'self' https://raw.githubusercontent.com; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" />
  <meta name="description" content="Watch live sports matches — Cricket, Football, F1, MotoGP and more. Real-time streaming." />
  <meta property="og:title" content="sportlive — Live Sports Streaming" />
  <meta property="og:description" content="Watch live sports matches in real time. Cricket, Football, F1, MotoGP and more." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#050811" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E&#x26BD;%3C/text%3E%3C/svg%3E" />
  <title>sportlive — Live Matches</title>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13"></script>
  <style is:global>
    .bg-stadium {
      background-image:
        radial-gradient(ellipse 80% 50% at 90% 30%, rgba(239, 68, 68, 0.15), transparent 50%),
        radial-gradient(ellipse 60% 50% at 10% 80%, rgba(239, 68, 68, 0.08), transparent 50%),
        linear-gradient(180deg, #050811 0%, #0a0f1a 100%);
    }
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .skeleton {
      background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.03) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
    }
    .glass {
      background: rgba(10, 15, 26, 0.55);
      backdrop-filter: blur(16px) saturate(140%);
      -webkit-backdrop-filter: blur(16px) saturate(140%);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .card {
      @apply text-left border border-white/10 rounded-xl overflow-hidden cursor-pointer
             transition-all duration-200 hover:border-primary/50 hover:-translate-y-0.5
             hover:shadow-lg hover:shadow-primary/10;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(12px) saturate(140%);
      -webkit-backdrop-filter: blur(12px) saturate(140%);
    }
    .card img {
      @apply w-full aspect-video object-cover block;
    }
    .play-icon { width: 10px; height: 10px; }
    .gradient-text {
      background: linear-gradient(90deg, #ef4444, #f87171);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .separator { width: 28px; height: 2px; background: #ef4444; }
    #video-shell.is-choosing {
      min-height: min(72vh, 460px);
    }
    #video-shell.is-choosing #video {
      position: absolute;
      inset: 0;
      height: 100%;
      object-fit: cover;
    }
    @media (min-width: 640px) {
      #video-shell.is-choosing {
        min-height: 0;
        aspect-ratio: 16 / 9;
      }
    }
  </style>
</head>
<body class="min-h-screen bg-stadium text-foreground font-sans antialiased overflow-x-hidden">
  <noscript>
    <div class="fixed inset-0 z-[100] bg-black/95 flex items-center justify-center p-8">
      <div class="text-center space-y-4 max-w-md">
        <p class="text-2xl font-bold text-white">JavaScript Required</p>
        <p class="text-muted-foreground">This app requires JavaScript to fetch and display live sports streams. Please enable JavaScript in your browser settings.</p>
      </div>
    </div>
  </noscript>

  <!-- Header (sticky, glassmorphism) -->
  <header class="sticky top-0 z-40 glass">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 h-16 relative flex items-center justify-end sm:justify-between">
      <!-- Mobile: centered logo -->
      <div class="sm:hidden absolute left-1/2 -translate-x-1/2 flex items-center gap-1 text-xl font-extrabold tracking-tight">
        <span class="text-white">sport</span><span class="gradient-text">live</span>
        <span class="ml-1 inline-block h-2 w-2 rounded-full bg-primary"></span>
      </div>
      <!-- Desktop: logo on left -->
      <div class="hidden sm:flex items-center gap-1 text-2xl font-extrabold tracking-tight">
        <span class="text-white">sport</span><span class="gradient-text">live</span>
        <span class="ml-1 inline-block h-2 w-2 rounded-full bg-primary"></span>
      </div>
      <nav class="flex items-center gap-6 text-sm text-muted-foreground"></nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 pt-10 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-end">
      <div class="lg:col-span-2 space-y-3">
        <p class="text-xs font-semibold tracking-[0.25em] text-primary uppercase">Now Streaming</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
          <span class="text-white">Live</span> <span class="gradient-text">Matches</span>
        </h1>
        <p class="text-muted-foreground text-sm sm:text-base max-w-md">
          Catch the action live, in real time.
        </p>
      </div>
      <div class="text-right space-y-2">
        <div class="hidden sm:block space-y-1">
          <p class="text-xs font-semibold tracking-[0.25em] text-muted-foreground uppercase">Live Sports</p>
          <p class="text-xs font-semibold tracking-[0.25em] text-muted-foreground uppercase">Anytime, Anywhere</p>
        </div>
        <div class="flex justify-end items-center gap-2 pt-3">
          <span class="text-xs text-muted-foreground"><span id="live-count">0</span> live matches</span>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Tabs -->
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 mb-6">
    <div class="inline-flex h-10 items-center justify-center rounded-md bg-white/5 border border-white/10 p-1">
      <button id="tab-live" type="button" class="tab-btn inline-flex items-center justify-center whitespace-nowrap rounded-sm px-4 py-1.5 text-sm font-medium transition-all" data-tab="live">
        <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-primary animate-pulse-dot"></span>
        Live
      </button>
      <button id="tab-upcoming" type="button" class="tab-btn inline-flex items-center justify-center whitespace-nowrap rounded-sm px-4 py-1.5 text-sm font-medium transition-all" data-tab="upcoming">
        Upcoming
      </button>
    </div>
  </section>

  <!-- Grid -->
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 pb-16">
    <div id="loader" class="text-muted-foreground text-sm">Loading manifest...</div>
    <div id="matches-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
  </section>

  <!-- Footer -->
  <footer class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-12 flex flex-col items-center gap-3">
    <p class="text-xs font-semibold tracking-[0.4em] text-muted-foreground uppercase">Sports Unites Us</p>
    <div class="separator"></div>
  </footer>

  <!-- Player Modal -->
  <div id="player-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 p-4" role="dialog" aria-modal="true" aria-labelledby="player-title">
    <div class="w-full max-w-[1000px]">
      <div class="mb-3 flex items-center justify-between">
        <span id="player-title" class="font-semibold"></span>
        <button id="close-player" type="button" class="inline-flex min-h-11 items-center justify-center rounded-md border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Close
        </button>
      </div>
      <div id="video-shell" class="relative overflow-hidden rounded-lg bg-black">
        <video id="video" class="aspect-video w-full bg-black" controls muted playsinline referrerpolicy="no-referrer" preload="metadata"></video>
        <div id="quality-chooser" class="absolute inset-0 hidden overflow-y-auto bg-gradient-to-b from-black/45 via-black/75 to-black/95 p-4 sm:p-8">
          <div class="mx-auto flex min-h-full max-w-2xl flex-col justify-center">
            <div class="mb-4 text-center">
              <p class="text-lg font-bold text-white sm:text-2xl">Choose video quality</p>
              <p class="mt-1 text-xs text-slate-300 sm:text-sm">You can change this while watching.</p>
            </div>
            <div id="quality-options" class="grid grid-cols-2 gap-2 sm:grid-cols-3" role="group" aria-label="Choose video quality"></div>
          </div>
        </div>
      </div>
      <div id="quality-controls" class="mt-3 hidden items-center justify-end gap-2">
        <label for="quality-select" class="text-sm text-muted-foreground">Quality</label>
        <select id="quality-select" aria-label="Video quality" class="min-h-11 min-w-36 rounded-md border border-white/10 bg-slate-900 px-3 py-2 text-sm font-medium text-white outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/40 disabled:cursor-wait disabled:opacity-60"></select>
      </div>
      <div id="player-message" class="hidden mt-3 text-center text-sm text-muted-foreground" role="status" aria-live="polite">
        No stream available for this event.
      </div>
    </div>
  </div>

  <script is:inline src="/player.js"></script>
</body>
</html>
