<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <title>Live Streams</title>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
</head>
<body class="min-h-screen bg-background text-foreground font-sans antialiased">
  <div class="mx-auto max-w-[1200px] px-4 py-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight">Live Streams</h1>
      <span class="text-xs text-muted-foreground">manifest: <code class="rounded bg-muted px-1.5 py-0.5 text-[11px]">/streams.json</code></span>
    </div>

    <div class="mb-6">
      <div class="inline-flex h-10 items-center justify-center rounded-md bg-muted p-1 text-muted-foreground">
        <button id="tab-live" type="button" class="tab-btn inline-flex items-center justify-center whitespace-nowrap rounded-sm px-4 py-1.5 text-sm font-medium transition-all" data-tab="live">
          <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-red-500 animate-pulse-dot"></span>
          Live
        </button>
        <button id="tab-upcoming" type="button" class="tab-btn inline-flex items-center justify-center whitespace-nowrap rounded-sm px-4 py-1.5 text-sm font-medium transition-all" data-tab="upcoming">
          Upcoming
        </button>
      </div>
    </div>

    <div id="loader" class="text-muted-foreground text-sm">Loading manifest...</div>
    <div id="matches-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
  </div>

  <div id="player-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 p-4">
    <div class="w-full max-w-[1000px]">
      <div class="mb-3 flex items-center justify-between">
        <span id="player-title" class="font-semibold"></span>
        <button id="close-player" type="button" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-3 py-1.5 text-sm font-medium text-foreground hover:bg-accent">
          Close
        </button>
      </div>
      <video id="video" class="aspect-video w-full rounded-lg bg-black" controls autoplay muted playsinline referrerpolicy="no-referrer"></video>
      <div id="player-message" class="hidden mt-3 text-center text-sm text-muted-foreground">
        No stream available for this event.
      </div>
    </div>
  </div>

  <script is:inline src="/demo-player.js"></script>
</body>
</html>
